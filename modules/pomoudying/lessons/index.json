---
---
[
  {%- assign first_lesson_file = true -%}
  {%- assign lesson_files = site.static_files | concat: site.pages -%}
  {%- for file in lesson_files -%}
    {%- if file.path contains 'modules/pomoudying/lessons/' -%}
      {%- assign file_extension = file.name | split: '.' | last | downcase -%}
      {%- if file_extension == 'txt' or file_extension == 'json' -%}
        {%- unless file.name == 'index.json' -%}
          {%- unless first_lesson_file -%},{%- endunless -%}
          {%- if file_extension == 'txt' and file.course -%}
            {
              "name": {{- file.name | jsonify -}},
              "id": {{- file.id | jsonify -}},
              "title": {{- file.title | jsonify -}},
              "course": {{- file.course | jsonify -}},
              "order": {{- file.order | jsonify -}},
              "courseOrder": {{- file.courseOrder | jsonify -}},
              "targetWPM": {{- file.targetWPM | jsonify -}},
              "targetAccuracy": {{- file.targetAccuracy | jsonify -}}
            }
          {%- else -%}
            {{- file.name | jsonify -}}
          {%- endif -%}
          {%- assign first_lesson_file = false -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
]
